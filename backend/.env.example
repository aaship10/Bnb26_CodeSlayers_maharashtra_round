# Copy to .env and adjust. All values shown are the dev defaults.
DATABASE_URL=postgresql+psycopg://fairdrop:fairdrop@localhost:5432/fairdrop
TEST_DATABASE_URL=postgresql+psycopg://fairdrop:fairdrop@localhost:5432/fairdrop_test

# dev | prod. Dev enables /admin/.../reset, the dev clock offset and dev auth.
APP_ENV=dev
# dev: X-User-Id header + POST /auth/dev-login. jwt: Member B's implementation.
AUTH_MODE=dev
ADMIN_TOKEN=dev-admin-token

# mock | drand
BEACON_PROVIDER=mock

# Member B defences. PLUGINS enables the gate, rate limits and /admin/defence/*.
# Needs Redis (REDIS_URL); locally: python ../Member_B_Pipeline/infra/local/fake_redis.py 6380
#PLUGINS=app.defence_plugin
#JWT_SECRET=<32+ random chars; also derives the challenge (PoW) signing key>
#REDIS_URL=redis://127.0.0.1:6380/0
#SIMULATION_MODE=true   # lets the simulator send X-Sim-Key / X-Sim-Client-IP; NEVER in production
#SIM_KEY=dev-sim-key
