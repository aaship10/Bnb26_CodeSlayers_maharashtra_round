# Template for infra/.env (git-ignored). `python infra/local/run.py up` creates infra/.env
# from this file and replaces every __GENERATE__ with a fresh random secret.
# Nothing secret is ever committed.

FD_ENV=dev
HTTP_PORT=8080
API_BASE_PORT=8001            # replicas listen on API_BASE_PORT .. API_BASE_PORT+N-1

# Private Postgres cluster the runner creates under .local/pg (your own Postgres on 5432 is untouched).
POSTGRES_PORT=5433
POSTGRES_USER=fairdrop
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=fairdrop
DB_POOL_SIZE=10

# Redis: use a real one if REDIS_URL is set and reachable; otherwise the runner starts a
# fakeredis TCP server on REDIS_FAKE_PORT (Lua supported, single process, NOT for load numbers).
REDIS_URL=
REDIS_FAKE_PORT=6380

ADMIN_TOKEN=__GENERATE__

# dev: identity = X-User-Id header. jwt: Authorization: Bearer <token> (use this for real tests).
AUTH_MODE=jwt
JWT_SECRET=__GENERATE__
OTP_PEPPER=__GENERATE__

# Simulation-only headers (X-Sim-Key, X-Sim-Client-IP) and OTP echo work ONLY when true.
SIMULATION_MODE=false
SIM_KEY=__GENERATE__

# Peers allowed to set X-Forwarded-For / X-Real-IP. Empty = trust nobody.
# The local gateway connects from loopback.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

ALLOWED_EMAIL_DOMAINS=example-college.edu

# Mail: leave SMTP_HOST empty to write messages to .local/outbox/*.json (default, no server
# needed). Set SMTP_HOST/SMTP_PORT to use Mailpit or any SMTP server.
SMTP_HOST=
SMTP_PORT=1025
# For a real provider (example: Gmail with an APP PASSWORD, never your normal password):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASSWORD=<app password>
#   MAIL_FROM=you@gmail.com   (SMTP_TLS defaults to starttls when SMTP_USER is set; port 465 => tls)
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=
MAIL_FROM=fairdrop@example-college.edu

# Built frontend served by the gateway (D). Empty = placeholder page.
FRONTEND_DIST=
SIMULATOR_URL=http://127.0.0.1:8100
